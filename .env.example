# Copia este archivo como .env.local y llena los valores.
# En Vercel ponlos en Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://hcflwxmrukzkepzeieot.supabase.co
# "Publishable key" (o la "anon" de la pestaña Legacy). Es pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (o la "service_role" de Legacy). SECRETA: nunca la compartas.
SUPABASE_SECRET_KEY=

# Correos que pueden entrar a /admin, separados por coma.
ADMIN_EMAILS=

# Airwallex → Settings → Developer → API keys.
# Si se dejan vacías, la app muestra tarjetas y movimientos de ejemplo.
# sandbox = pruebas, production = tarjetas reales.
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
